{
  "manifest_version": 3,
  "name": "GitHub Proxy Redirect",
  "version": "1.3.1",
  "description": "将所有 GitHub 下载链接通过网络层拦截替换为 v6.gh-proxy.com 代理地址",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "*://github.com/*",
    "*://raw.githubusercontent.com/*",
    "*://codeload.github.com/*",
    "*://release-assets.githubusercontent.com/*",
    "*://objects.githubusercontent.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "github_proxy_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*",
        "*://raw.githubusercontent.com/*",
        "*://codeload.github.com/*",
        "*://release-assets.githubusercontent.com/*",
        "*://objects.githubusercontent.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GitHub Proxy Redirect"
  }
}